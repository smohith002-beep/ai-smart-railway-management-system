# ===============================================================
# AI SMART RAILWAY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ===============================================================

# 1. Production Site URL (Used for Canonical URLs, Sitemap & OpenGraph)
VITE_SITE_URL=https://smartrailway.in

# 2. Google Search Console Verification Token
# (Paste your Google HTML tag verification code here, e.g. abc123XYZ456...)
VITE_GOOGLE_SITE_VERIFICATION=

# 3. Supabase Backend Realtime Ledger
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. AI Operations Copilot Engine (Optional Gemini API)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 5. Third-Party Indian Railways Live Telemetry API (RapidAPI / IRCTC)
# Get your API key from RapidAPI (e.g. IRCTC / Indian Railway Live Status API)
# Example host: irctc1.p.rapidapi.com or indian-railway-irctc.p.rapidapi.com
VITE_RAILWAY_API_KEY=
VITE_RAILWAY_API_HOST=irctc1.p.rapidapi.com
VITE_RAILWAY_API_URL=https://irctc1.p.rapidapi.com
VITE_RAILWAY_API_PROVIDER=RAPIDAPI_IRCTC
